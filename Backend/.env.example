SEED_ADMIN_EMAIL="admin@ahsanhub.com"
SEED_ADMIN_PASSWORD="change-me"
REVALIDATE_SECRET="same-value-as-the-frontend"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
